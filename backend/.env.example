# Copia este archivo a .env (está en .gitignore) y rellena solo lo que uses.
# Solo para la CLI y desarrollo: la app de escritorio guarda los ajustes en
# %LOCALAPPDATA%\SetID\settings.json y las claves en el Administrador de credenciales.

# fake | acrcloud | audd | shazam
SETID_PROVIDER=fake

# Segmentación (segundos)
SETID_WINDOW_S=12
SETID_STEP_S=30

# Reconocimiento. Sin definir = valores recomendados por proveedor
# (p. ej. Shazam: 1 consulta a la vez con 1,5 s de pausa).
# SETID_CONCURRENCY=3
# SETID_MIN_INTERVAL_S=0
# SETID_DAILY_QUERY_BUDGET=200

# Confianza fija para proveedores sin puntuación (Shazam, AudD). Por debajo de
# SETID_MIN_CONFIDENCE (0.5), una detección suelta se descarta.
# SETID_SHAZAM_CONFIDENCE=0.45

# Agregación
SETID_MIN_CONFIDENCE=0.5
SETID_MAX_GAP_SEGMENTS=2
SETID_UNKNOWN_MIN_SEGMENTS=3

# ACRCloud (consola de ACRCloud → proyecto de "Audio & Video Recognition")
SETID_ACRCLOUD_HOST=identify-eu-west-1.acrcloud.com
SETID_ACRCLOUD_ACCESS_KEY=
SETID_ACRCLOUD_ACCESS_SECRET=

# AudD (https://dashboard.audd.io)
SETID_AUDD_API_TOKEN=
